# Local QuakeStudio API.
# Copy this file to .env and change the database password before running.

QUAKESTUDIO_DATABASE_URL=postgresql+psycopg://quakestudio:quakestudio@localhost:5432/quakestudio
QUAKESTUDIO_AUTO_CREATE_TABLES=false

# The Vite dev server may be opened at either spelling.
QUAKESTUDIO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

QUAKESTUDIO_SESSION_COOKIE_NAME=quakestudio_admin_session
QUAKESTUDIO_SESSION_TTL_HOURS=12
# Keep false locally: the API is plain HTTP on loopback.
QUAKESTUDIO_COOKIE_SECURE=false
# Use "none" together with COOKIE_SECURE=true only when the frontend and API
# are on different sites, for example a Vercel frontend calling Render.
QUAKESTUDIO_COOKIE_SAMESITE=lax
QUAKESTUDIO_ENABLE_DOCS=true

# Used only by `python -m app.seed`. Do not commit a real password.
QUAKESTUDIO_ADMIN_EMAIL=admin@quakestudio.local
QUAKESTUDIO_ADMIN_PASSWORD=replace-this-local-password
QUAKESTUDIO_ADMIN_DISPLAY_NAME=Administrator

# Hosted deployment (Render): set these in the Render dashboard instead.
# QUAKESTUDIO_ENVIRONMENT=production
# QUAKESTUDIO_ALLOWED_ORIGINS=https://quake-studio.vercel.app
# QUAKESTUDIO_COOKIE_SECURE=true
# QUAKESTUDIO_COOKIE_SAMESITE=none
# QUAKESTUDIO_ENABLE_DOCS=false
